<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions, merged into the main manifest for debug builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Static receiver: handles EXPLICIT broadcasts (am broadcast ... -p com.brainstormity.voicecontrol),
             and starts the process if it isn't running. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.brainstormity.voicecontrol.RUN_TASK" />
                <action android:name="com.brainstormity.voicecontrol.STOP" />
                <action android:name="com.brainstormity.voicecontrol.VOICE_START" />
                <action android:name="com.brainstormity.voicecontrol.VOICE_STOP" />
                <action android:name="com.brainstormity.voicecontrol.VOICE_TEXT" />
                <action android:name="com.brainstormity.voicecontrol.OVERLAY_START" />
                <action android:name="com.brainstormity.voicecontrol.OVERLAY_STOP" />
                <action android:name="com.brainstormity.voicecontrol.OVERLAY_DEMO" />
            </intent-filter>
        </receiver>
        <!-- Registers a runtime copy of DebugReceiver at process start so IMPLICIT broadcasts
             (plain `am broadcast -a ...`, no -p) also arrive; Android 8+ never delivers those to
             manifest receivers. -->
        <provider
            android:name=".debug.DebugReceiverInstaller"
            android:authorities="${applicationId}.debug-receiver-installer"
            android:exported="false" />

        <!-- voice/auth debug hooks (AUTH_IMPORT / AUTH_STATUS / AUTH_REFRESH / AUTH_SIGNOUT / AUTH_LOGIN / AUTH_PROBE).
             Same manifest + runtime-registered pattern as DebugReceiver. -->
        <receiver
            android:name=".debug.AuthDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.brainstormity.voicecontrol.AUTH_IMPORT" />
                <action android:name="com.brainstormity.voicecontrol.AUTH_STATUS" />
                <action android:name="com.brainstormity.voicecontrol.AUTH_REFRESH" />
                <action android:name="com.brainstormity.voicecontrol.AUTH_SIGNOUT" />
                <action android:name="com.brainstormity.voicecontrol.AUTH_LOGIN" />
                <action android:name="com.brainstormity.voicecontrol.AUTH_PROBE" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".debug.AuthDebugReceiverInstaller"
            android:authorities="${applicationId}.auth-debug-receiver-installer"
            android:exported="false" />
        <!-- GPT-Live debug hooks (voice/live): LIVE_START / LIVE_STOP / LIVE_TEXT / LIVE_SAY / LIVE_INJECT. -->
        <receiver
            android:name=".debug.LiveDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.brainstormity.voicecontrol.LIVE_START" />
                <action android:name="com.brainstormity.voicecontrol.LIVE_STOP" />
                <action android:name="com.brainstormity.voicecontrol.LIVE_TEXT" />
                <action android:name="com.brainstormity.voicecontrol.LIVE_SAY" />
                <action android:name="com.brainstormity.voicecontrol.LIVE_INJECT" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".debug.LiveDebugInstaller"
            android:authorities="${applicationId}.live-debug-installer"
            android:exported="false" />
        <service
            android:name=".debug.LiveDebugMicService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
