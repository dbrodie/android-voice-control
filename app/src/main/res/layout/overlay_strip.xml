<?xml version="1.0" encoding="utf-8"?>
<!-- Slim status strip shown while a task runs. Not touchable; the stop button is a separate window on top. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_strip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="@dimen/vc_strip_stop_width">

    <View
        android:id="@+id/stripDot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_accent_dot" />

    <TextView
        android:id="@+id/stripText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/vc_pill_text"
        android:textSize="11sp" />
</LinearLayout>
