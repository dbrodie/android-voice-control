<?xml version="1.0" encoding="utf-8"?>
<!-- JevKeyActivity. Edge-to-edge: the activity pads the ScrollView with the system-bar / IME insets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jevRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/jev_title"
            android:textColor="@color/vc_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/jev_what_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/jev_what_body"
            android:textColor="@color/vc_text"
            android:textSize="14sp" />

        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/jev_how_title" />

        <LinearLayout style="@style/VC.Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/jev_how_body"
                android:textColor="@color/vc_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/jevOpenConsole"
                style="@style/VC.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/jev_open_console" />

            <Button
                android:id="@+id/jevOpenSite"
                style="@style/VC.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jev_open_site" />
        </LinearLayout>

        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/jev_current_title" />

        <LinearLayout style="@style/VC.Card">

            <TextView
                android:id="@+id/jevCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/vc_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/jevLastCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/vc_text_secondary"
                android:textSize="13sp" />

            <TextView
                style="@style/VC.FieldLabel"
                android:text="@string/jev_input_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/jevKeyField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:hint="@string/jev_input_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/jevPaste"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jev_paste" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/jevShowKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/jev_show_key"
                android:textColor="@color/vc_text_secondary" />

            <Button
                android:id="@+id/jevVerify"
                style="@style/VC.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/jev_verify_save" />

            <TextView
                android:id="@+id/jevResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/jevSaveAnyway"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jev_save_anyway"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/jevRemove"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/jev_remove"
                    android:textColor="@color/vc_error" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/jev_privacy_note"
                android:textColor="@color/vc_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
