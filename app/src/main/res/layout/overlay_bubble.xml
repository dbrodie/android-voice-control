<?xml version="1.0" encoding="utf-8"?>
<!-- Window is 72dp square: a 56dp bubble with 8dp of room on each side for the pulsing ring + shadow. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vc_bubble_window"
    android:layout_height="@dimen/vc_bubble_window"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/bubbleRing"
        android:layout_width="@dimen/vc_bubble_size"
        android:layout_height="@dimen/vc_bubble_size"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/bg_bubble_ring" />

    <ImageView
        android:id="@+id/bubble"
        android:layout_width="@dimen/vc_bubble_size"
        android:layout_height="@dimen/vc_bubble_size"
        android:layout_gravity="center"
        android:background="@drawable/bg_bubble"
        android:contentDescription="@string/overlay_bubble_description"
        android:elevation="5dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_mic_bubble" />
</FrameLayout>
