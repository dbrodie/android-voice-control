<?xml version="1.0" encoding="utf-8"?>
<!-- One GPT-Live voice session in RunsActivity's Voice tab (T12). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/voiceWhen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/vc_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/voiceCost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/vc_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/voicePlanNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/runs_voice_plan_note"
        android:textColor="@color/vc_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/voiceMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/vc_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/voiceError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/vc_error"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/voiceTasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />
</LinearLayout>
