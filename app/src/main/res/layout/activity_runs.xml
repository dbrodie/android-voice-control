<?xml version="1.0" encoding="utf-8"?>
<!-- RunsActivity. Edge-to-edge: the activity pads the root with the system-bar insets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/runsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/runs_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/runs_title"
            android:textColor="@color/vc_text"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tabs: Runs | Trash (n) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tabRuns"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/runs_tab_runs"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabVoice"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/runs_tab_voice"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabTrash"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/runs_tab_trash"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vc_card_stroke" />

    <ScrollView
        android:id="@+id/runsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/runsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Totals (Runs and Voice tabs): JEV runs on top, GPT voice below, then the all-in total -->
            <LinearLayout
                android:id="@+id/totalsCard"
                style="@style/VC.Card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/totalRuns"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalCost"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalTokens"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalSuccess"
                        layout="@layout/item_run_stat" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/vc_card_stroke" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/totalVoiceSessions"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalVoiceMinutes"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalVoiceCost"
                        layout="@layout/item_run_stat" />

                    <include
                        android:id="@+id/totalAllIn"
                        layout="@layout/item_run_stat" />
                </LinearLayout>

                <TextView
                    android:id="@+id/totalsNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- The task running right now (Runs tab) -->
            <LinearLayout
                android:id="@+id/liveCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_live"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/liveChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/liveStep"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/vc_text_secondary"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/liveStop"
                        style="@style/VC.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/vc_stop"
                        android:minWidth="72dp"
                        android:text="@string/runs_stop" />
                </LinearLayout>

                <TextView
                    android:id="@+id/liveTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vc_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/liveAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/vc_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/liveMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Trash tab: select all / restore / delete forever -->
            <LinearLayout
                android:id="@+id/trashBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/selectAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/runs_select_all"
                    android:textColor="@color/vc_text" />

                <Button
                    android:id="@+id/restoreButton"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runs_restore" />

                <Button
                    android:id="@+id/purgeButton"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/runs_delete_forever"
                    android:textColor="@color/vc_error" />
            </LinearLayout>

            <TextView
                android:id="@+id/listNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:textColor="@color/vc_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/runsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="48dp"
                android:textColor="@color/vc_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
