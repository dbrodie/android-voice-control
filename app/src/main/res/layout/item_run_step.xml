<?xml version="1.0" encoding="utf-8"?>
<!-- One step of a run report: the annotated screenshot (tap = full screen) next to JEV's decision. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/stepImage"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="@color/vc_card_stroke"
        android:contentDescription="@string/run_step_image"
        android:minHeight="200dp"
        android:scaleType="fitStart" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/vc_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/vc_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/stepWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/stepConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/stepConfidenceBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressBackgroundTint="@color/vc_card_stroke"
            android:progressTint="@color/vc_accent" />

        <TextView
            android:id="@+id/stepTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/stepZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.06"
            android:text="@string/run_other_options"
            android:textAllCaps="true"
            android:textColor="@color/vc_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/stepOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/stepResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/vc_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stepTiming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/stepCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/vc_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
