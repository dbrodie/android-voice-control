<?xml version="1.0" encoding="utf-8"?>
<!-- Edge-to-edge: MainActivity pads this ScrollView with the system-bar / IME insets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bubble"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_mic_bubble" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_title"
                    android:textColor="@color/vc_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_subtitle"
                    android:textColor="@color/vc_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- How to use -->
        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/how_to_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/how_to_body"
            android:textColor="@color/vc_text"
            android:textSize="14sp" />

        <!-- Setup checklist -->
        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/section_setup" />

        <LinearLayout
            android:id="@+id/checklist"
            style="@style/VC.Card"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/overlayButton"
            style="@style/VC.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/start_overlay"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/overlayStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:textColor="@color/vc_text_secondary"
            android:textSize="13sp" />

        <!-- Voice backend -->
        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/section_voice" />

        <LinearLayout style="@style/VC.Card">

            <RadioGroup
                android:id="@+id/backendGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/backendAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backend_auto"
                    android:textColor="@color/vc_text" />

                <RadioButton
                    android:id="@+id/backendChatGpt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backend_chatgpt"
                    android:textColor="@color/vc_text" />

                <RadioButton
                    android:id="@+id/backendOpenAiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backend_openai_key"
                    android:textColor="@color/vc_text" />
            </RadioGroup>

            <TextView
                android:id="@+id/backendDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/vc_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Settings (collapsible) -->
        <LinearLayout
            android:id="@+id/settingsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                style="@style/VC.SectionTitle"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="@string/section_settings" />

            <TextView
                android:id="@+id/settingsChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="▸"
                android:textColor="@color/vc_text_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsBody"
            style="@style/VC.Card"
            android:visibility="gone">

            <!-- JEV API key: a Setup-style row (MainActivity.addJevKeyRow) that opens JevKeyActivity. -->
            <LinearLayout
                android:id="@+id/jevKeySettingsSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/VC.FieldLabel"
                android:text="@string/settings_openai_key" />

            <EditText
                android:id="@+id/openAiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/showKeysCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_show_keys"
                android:textColor="@color/vc_text_secondary" />

            <TextView
                style="@style/VC.FieldLabel"
                android:text="@string/settings_model" />

            <EditText
                android:id="@+id/modelInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/settings_key_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_saved_note"
                android:textColor="@color/vc_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Test without voice -->
        <TextView
            style="@style/VC.SectionTitle"
            android:text="@string/section_test" />

        <LinearLayout style="@style/VC.Card">

            <EditText
                android:id="@+id/taskInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/test_task_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="3"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/runButton"
                    style="@style/VC.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_run" />

                <Button
                    android:id="@+id/stopButton"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_stop" />

                <Button
                    android:id="@+id/clearLogButton"
                    style="@style/VC.Button.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/test_clear" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_log"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true"
                android:padding="10dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:hint="@string/test_log_empty"
                    android:textColor="@color/vc_log_text"
                    android:textColorHint="#7A828E"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
