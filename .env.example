# Copy to .env. Paths used by the Gradle scripts:
JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
ANDROID_HOME="/Users/you/Library/Android/sdk"
# Optional, debug builds only (release never embeds keys). Set EMBED_KEYS=false to keep them out of debug too.
JEV_KEY=
OPENAI_API_KEY=
